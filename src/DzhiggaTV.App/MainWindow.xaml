<Window x:Class="DzhiggaTV.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:player="clr-namespace:DzhiggaTV.Player;assembly=DzhiggaTV.Player" xmlns:local="clr-namespace:DzhiggaTV.App" Style="{StaticResource {x:Type Window}}" Title="DzhiggaTV" Width="1440" Height="880" MinWidth="940" MinHeight="600" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <Style x:Key="NavigationLabel" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid x:Name="LayoutRoot">
  <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="76"/><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="32"/></Grid.RowDefinitions>
  <Border x:Name="Header" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/DzhiggaTV-logo.png" Width="40" Height="40" Margin="0,0,12,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Логотип DzhiggaTV"/><TextBlock Text="Dzhigga" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="TV" Foreground="{DynamicResource AccentBrush}" FontSize="23" FontWeight="Light" VerticalAlignment="Center"/><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="6,0,0,0" Margin="16,0,0,0" VerticalAlignment="Center"><Button x:Name="VersionButton" Click="Version_Click" ToolTip="История версий" AutomationProperties.Name="История версий" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,4" Margin="0"><StackPanel><TextBlock Text="ВЕРСИЯ" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{x:Static local:App.DisplayVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,1,0,0"/></StackPanel></Button></Border></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="Workspace">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="64" MinWidth="64"/><ColumnDefinition x:Name="ChannelColumn" Width="350" MinWidth="270"/><ColumnDefinition x:Name="SplitterColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="100"/></Grid.ColumnDefinitions>
   <Border x:Name="Navigation" Background="{DynamicResource PanelBrush}" Padding="8,20,8,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="NavToggleButton" Click="CollapseNav_Click" Style="{StaticResource NavButton}" ToolTip="Развернуть панель" AutomationProperties.Name="Развернуть панель"><TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Width="20" TextAlignment="Center"/></Button>
      <TextBlock x:Name="SidebarFootnote" Visibility="Collapsed" Text="Личное пространство.&#10;Без облачных аккаунтов." Foreground="{DynamicResource MutedBrush}" FontSize="11" LineHeight="18" Margin="8,16,0,2"/>
     </StackPanel>
     <StackPanel>
      <TextBlock x:Name="NavHeading" Visibility="Collapsed" Text="БИБЛИОТЕКА" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,0,0,16"/>
      <Button Style="{StaticResource NavButton}" Tag="favorites" Click="Navigate_Click" ToolTip="Избранное" AutomationProperties.Name="Избранное"><StackPanel Orientation="Horizontal"><TextBlock Text="☆" Width="20" TextAlignment="Center" FontSize="18"/><TextBlock Text="Избранное" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="all" Click="Navigate_Click" ToolTip="Все каналы" AutomationProperties.Name="Все каналы"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="20" TextAlignment="Center" FontSize="18"/><TextBlock Text="Все каналы" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="categories" Click="Navigate_Click" ToolTip="Категории" AutomationProperties.Name="Категории"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" Width="20" TextAlignment="Center" FontSize="18"/><TextBlock Text="Категории" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="guide" Click="Navigate_Click" ToolTip="Телепрограмма" AutomationProperties.Name="Телепрограмма"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Width="20" TextAlignment="Center" FontSize="18"/><TextBlock Text="Телепрограмма" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="recent" Click="Navigate_Click" ToolTip="Недавно просмотренные" AutomationProperties.Name="Недавно просмотренные"><StackPanel Orientation="Horizontal"><TextBlock Text="↶" Width="20" TextAlignment="Center" FontSize="18"/><TextBlock Text="Недавние" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="10,18"/>
      <Button Style="{StaticResource NavButton}" Click="Settings_Click" ToolTip="Настройки" AutomationProperties.Name="Настройки"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Width="20" TextAlignment="Center"/><TextBlock Text="Настройки" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" x:Name="ChannelPanel" Margin="16,20,12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ChannelCountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,10"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,8"><TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск канала (Ctrl+F)" AutomationProperties.Name="Поиск каналов"/><TextBlock Text="⌕  Поиск каналов" IsHitTestVisible="False" Margin="12,9" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <Grid Grid.Row="2" Margin="-3,0,-3,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ToolTip="Категория"/><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" ToolTip="Порядок"/></Grid>
    <ListBox x:Name="ChannelList" Grid.Row="3" ItemsSource="{Binding VisibleChannels}" SelectedItem="{Binding SelectedChannel}" ItemTemplate="{StaticResource ChannelTemplate}" SelectionChanged="Channel_Selected" ScrollViewer.ScrollChanged="Channels_Scrolled" PreviewMouseRightButtonDown="Channel_RightClick" PreviewMouseLeftButtonDown="Channel_DragStart" PreviewMouseMove="Channel_DragMove" AllowDrop="True" Drop="Channel_Drop"/>
   </Grid>
   <GridSplitter x:Name="Splitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
   <Grid Grid.Column="3" x:Name="ViewingPanel" Margin="20,20,24,14"><Grid.RowDefinitions><RowDefinition x:Name="ViewingHeadingRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="ProgrammeRow" Height="170"/></Grid.RowDefinitions>
    <Grid x:Name="ViewingHeading" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="ActiveChannelLogo" Width="48" Height="34" Margin="0,0,12,0" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Active.LogoPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding Active.LogoPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Логотип текущего канала"/></Border><TextBlock Grid.Column="1" Text="{Binding ActiveName}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/><TextBlock Grid.Column="2" x:Name="ClockText" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></Grid>
    <Border x:Name="VideoBorder" Grid.Row="1" Background="#050708" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid x:Name="VideoArea"><player:NativeVideoHost x:Name="VideoHost"/></Grid></Border>
    <Grid Grid.Row="2" x:Name="ProgrammePanel" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource PanelBrush}" CornerRadius="11" Padding="18"><StackPanel><TextBlock Text="СЕЙЧАС В ЭФИРЕ" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding CurrentTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,7"/><TextBlock Text="{Binding CurrentTime}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}" Margin="0,17,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="11" Padding="18"><Grid><StackPanel><TextBlock Text="ДАЛЕЕ" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NextTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,7"/><TextBlock Text="{Binding NextTime}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></StackPanel><Button Content="Программа  →" Click="Guide_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,5" FontSize="11" Background="Transparent"/></Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="StatusBar" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,6"><Grid><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,200,0"/><TextBlock Text="F11  полный экран     I  статистика" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></Grid></Border>
 </Grid>
</Window>
