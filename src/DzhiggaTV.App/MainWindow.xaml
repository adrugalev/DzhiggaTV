<Window x:Class="DzhiggaTV.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:player="clr-namespace:DzhiggaTV.Player;assembly=DzhiggaTV.Player" xmlns:local="clr-namespace:DzhiggaTV.App" Style="{StaticResource {x:Type Window}}" Title="DzhiggaTV" WindowStyle="None" Width="1440" Height="880" MinWidth="940" MinHeight="600" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <Style x:Key="NavigationLabel" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="CaptionRoot" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionRoot" Property="Background" Value="{DynamicResource CardBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CaptionRoot" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionRoot" Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="LayoutRoot">
  <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="{x:Static local:MainWindow.TitleBarRowHeight}"/><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="{x:Static local:MainWindow.StatusBarRowHeight}"/></Grid.RowDefinitions>
  <Border x:Name="Header" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,142,0"><Image Source="Assets/DzhiggaTV-logo.png" Width="28" Height="28" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Логотип DzhiggaTV"/><TextBlock Text="Dzhigga" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="TV" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Light" VerticalAlignment="Center"/><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="6,0,0,0" Margin="12,0,0,0" VerticalAlignment="Center"><Button x:Name="VersionButton" Click="Version_Click" AutomationProperties.Name="Версия и обновления" Padding="8,3" Margin="0">
 <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="ToolTip" Value="История версий и проверка обновлений"/>
  <Style.Triggers><DataTrigger Binding="{Binding Updates.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="#193F3B"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="ToolTip" Value="Доступна новая версия — нажмите, чтобы обновить"/></DataTrigger></Style.Triggers>
 </Style></Button.Style>
 <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static local:App.DisplayVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text=" ↑" FontSize="12" Foreground="{DynamicResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Updates.HasUpdate, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
</Button></Border></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно"><Path Data="M 0,5 L 12,5" Width="12" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/></Button>
     <Button x:Name="MaximizeButton" Click="MaximizeRestore_Click">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
       <Setter Property="ToolTip" Value="Развернуть"/><Setter Property="AutomationProperties.Name" Value="Развернуть окно"/>
       <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="Восстановить размер"/><Setter Property="AutomationProperties.Name" Value="Восстановить размер окна"/></DataTrigger></Style.Triggers>
      </Style></Button.Style>
      <Path Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3">
       <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 0,0 L 10,0 10,10 0,10 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M 3,3 L 3,0 12,0 12,9 9,9 M 0,3 L 9,3 9,12 0,12 Z"/></DataTrigger></Style.Triggers></Style></Path.Style>
      </Path>
     </Button>
     <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть окно"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="Workspace">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="64" MinWidth="64"/><ColumnDefinition x:Name="ChannelColumn" Width="350" MinWidth="270"/><ColumnDefinition x:Name="SplitterColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="100"/></Grid.ColumnDefinitions>
   <Border x:Name="Navigation" Background="{DynamicResource PanelBrush}" Padding="8,20,8,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="NavToggleButton" Click="CollapseNav_Click" Style="{StaticResource NavButton}" ToolTip="Развернуть панель" AutomationProperties.Name="Развернуть панель"><TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Width="20" TextAlignment="Center"/></Button>
     </StackPanel>
     <StackPanel>
      <TextBlock x:Name="NavHeading" Visibility="Collapsed" Text="БИБЛИОТЕКА" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,0,0,16"/>
      <Button Style="{StaticResource NavButton}" Tag="favorites" Click="Navigate_Click" ToolTip="Избранное" AutomationProperties.Name="Избранное"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="favorites"/><TextBlock Text="Избранное" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="all" Click="Navigate_Click" ToolTip="Все каналы" AutomationProperties.Name="Все каналы"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="channels"/><TextBlock Text="Все каналы" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="categories" Click="Navigate_Click" ToolTip="Категории" AutomationProperties.Name="Категории"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="categories"/><TextBlock Text="Категории" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="guide" Click="Navigate_Click" ToolTip="Телепрограмма" AutomationProperties.Name="Телепрограмма"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="guide"/><TextBlock Text="Телепрограмма" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="recent" Click="Navigate_Click" ToolTip="Недавно просмотренные" AutomationProperties.Name="Недавно просмотренные"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="recent"/><TextBlock Text="Недавние" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="sports" Click="Navigate_Click" ToolTip="Мультиэкран" AutomationProperties.Name="Мультиэкран"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="sports"/><TextBlock Text="Мультиэкран" FontSize="13" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="10,18"/>
      <Button Style="{StaticResource NavButton}" Click="Settings_Click" ToolTip="Настройки" AutomationProperties.Name="Настройки"><StackPanel Orientation="Horizontal"><local:NavigationIcon Icon="settings"/><TextBlock Text="Настройки" Tag="NavLabel" Style="{StaticResource NavigationLabel}"/></StackPanel></Button>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" x:Name="ChannelPanel" Margin="16,20,12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ChannelCountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,10"/></StackPanel>
    <Grid x:Name="ChannelSearch" Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding CanSearch}"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CanSearch}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Канал или передача сейчас и далее (Ctrl+F)" AutomationProperties.Name="Поиск каналов и передач"/><TextBlock Text="⌕  Канал или передача" IsHitTestVisible="False" Margin="12,9" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <ComboBox x:Name="ChannelCategory" Grid.Row="2" Margin="0,0,0,10" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ToolTip="Категория" IsEnabled="{Binding CanSearch}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsFavorites}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
    <ListBox x:Name="ChannelList" Grid.Row="3" ItemsSource="{Binding VisibleChannels}" SelectedItem="{Binding SelectedChannel}" ItemTemplate="{StaticResource ChannelTemplate}" SelectionChanged="Channel_Selected" ScrollViewer.ScrollChanged="Channels_Scrolled" PreviewMouseRightButtonDown="Channel_RightClick" PreviewMouseLeftButtonDown="Channel_DragStart" PreviewMouseMove="Channel_DragMove" AllowDrop="True" Drop="Channel_Drop"/>
   </Grid>
   <GridSplitter x:Name="Splitter" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
   <Grid Grid.Column="3" x:Name="ViewingPanel" Margin="20,20,24,14"><Grid.RowDefinitions><RowDefinition x:Name="ViewingHeadingRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="ProgrammeRow" Height="150"/></Grid.RowDefinitions>
    <Grid x:Name="ViewingHeading" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="ActiveChannelLogo" Width="48" Height="34" Margin="0,0,12,0" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Active.LogoPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><local:ChannelLogo Path="{Binding Active.LogoPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Логотип текущего канала"/></Border><TextBlock Grid.Column="1" Text="{Binding ActiveName}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/><TextBlock Grid.Column="2" x:Name="ClockText" Foreground="{DynamicResource MutedBrush}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
    <Border x:Name="VideoBorder" Grid.Row="1" Background="#050708" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid x:Name="VideoArea"><player:NativeVideoHost x:Name="VideoHost"/></Grid></Border>
    <Grid Grid.Row="2" x:Name="ProgrammePanel" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.Resources>
      <Style x:Key="ProgrammeTitle" TargetType="TextBlock">
       <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="LineHeight" Value="20"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
       <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
       <Setter Property="MaxHeight" Value="40"/><Setter Property="Margin" Value="0,2,0,2"/>
      </Style>
      <Style x:Key="ProgrammeDescription" TargetType="TextBlock">
       <Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
       <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="WordEllipsis"/><Setter Property="MaxHeight" Value="36"/>
       <Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="0,7,0,0"/>
       <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
      </Style>
      <Style x:Key="ProgrammeDetails" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="Content" Value="Подробнее"/><Setter Property="Visibility" Value="Hidden"/>
       <Setter Property="FontSize" Value="11"/><Setter Property="Height" Value="20"/>
       <Setter Property="Padding" Value="6,0"/><Setter Property="Margin" Value="0"/>
       <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
       <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
       <Setter Property="HorizontalAlignment" Value="Right"/>
       <Setter Property="AutomationProperties.HelpText" Value="Наведите для полного описания. Перейдите на описание, чтобы прочитать и прокрутить его."/>
      </Style>
      <Style x:Key="UpcomingTitle" TargetType="TextBlock">
       <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/>
       <Setter Property="Margin" Value="0,1,0,1"/>
      </Style>
      <Style x:Key="ProgrammeHistoryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
       <Setter Property="MinWidth" Value="80"/><Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="0"/>
       <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1"/>
       <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
       <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="5" Margin="3"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
       <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/></Trigger>
       </Style.Triggers>
      </Style>
     </Grid.Resources>
     <Border x:Name="CurrentProgrammeCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="13,7">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="20"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding PlaybackProgrammeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
         <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasArchive}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <Button x:Name="PreviousProgrammeButton" Style="{StaticResource ProgrammeHistoryButton}" Click="PreviousProgramme_Click" IsEnabled="{Binding CanGoBack}" ToolTip="{Binding BackHint}" AutomationProperties.Name="Предыдущая передача">
          <StackPanel Orientation="Horizontal"><Path Data="M 6,0 L 1,5 L 6,10 M 1,5 L 11,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Ранее" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel>
         </Button>
         <Button x:Name="FollowingProgrammeButton" Click="FollowingProgramme_Click" IsEnabled="{Binding CanGoForward}" ToolTip="Следующая передача" AutomationProperties.Name="Следующая передача">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ProgrammeHistoryButton}"><Setter Property="MinWidth" Value="28"/><Setter Property="Width" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsBrowsing}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
          <Path Data="M 6,0 L 11,5 L 6,10 M 1,5 L 11,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Button>
        </StackPanel>
        <Button x:Name="CurrentProgrammeGuideButton" Grid.Column="1" Content="Телепрограмма →" Click="Guide_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5,0" Margin="0" FontSize="11" Height="20" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Открыть телепрограмму">
         <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding HasArchive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
       </Grid>
       <TextBlock Grid.Row="1" Text="{Binding CurrentTitle}" Style="{StaticResource ProgrammeTitle}"/>
       <TextBlock Grid.Row="2" Text="{Binding CurrentTime}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
       <TextBlock x:Name="CurrentProgrammeDescription" Grid.Row="3" Text="{Binding CurrentDescriptionPreview}" Style="{StaticResource ProgrammeDescription}" Margin="0,4,0,0"/>
       <Grid Grid.Row="4" Height="20" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Style.Triggers><DataTrigger Binding="{Binding IsBrowsing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
        <StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsBrowsing}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <Button x:Name="PlayBrowsedProgrammeButton" Content="{Binding PlayLabel}" ToolTip="{Binding PlayHint}" Click="PlayBrowsedProgramme_Click" IsEnabled="{Binding CanPlay}" FontSize="10" Height="20" Padding="6,0" Margin="0,0,3,0" BorderBrush="{DynamicResource AccentBrush}" AutomationProperties.Name="Смотреть выбранную передачу в архиве"/>
         <Button Content="В прямой эфир" ToolTip="Вернуться к прямому эфиру и актуальным передачам" Click="ProgrammeLive_Click" FontSize="10" Height="20" Padding="4,0" Margin="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="В прямой эфир"/>
        </StackPanel>
        <Button x:Name="CurrentProgrammeDetails" Grid.Column="1" Style="{StaticResource ProgrammeDetails}" AutomationProperties.Name="Подробнее о текущей передаче"/>
       </Grid>
      </Grid>
     </Border>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
      <Border x:Name="NextProgrammeCard" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14,7">
       <Grid><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="ДАЛЕЕ" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NextTime}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></Grid>
        <TextBlock Grid.Row="1" Text="{Binding NextTitle}" Style="{StaticResource UpcomingTitle}"/>
        <Button x:Name="NextProgrammeDetails" Grid.Row="2" Style="{StaticResource ProgrammeDetails}" HorizontalAlignment="Left" Padding="0" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="Подробнее о следующей передаче"/>
       </Grid>
      </Border>
      <Border x:Name="AfterNextProgrammeCard" Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14,7">
       <Grid><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="ЗАТЕМ" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding AfterNextTime}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></Grid>
        <TextBlock Grid.Row="1" Text="{Binding AfterNextTitle}" Style="{StaticResource UpcomingTitle}"/>
        <Button x:Name="AfterNextProgrammeDetails" Grid.Row="2" Style="{StaticResource ProgrammeDetails}" HorizontalAlignment="Left" Padding="0" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="Подробнее о второй следующей передаче"/>
       </Grid>
      </Border>
      </Grid>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="StatusBar" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LibraryChannelCountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="F11  полный экран" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
