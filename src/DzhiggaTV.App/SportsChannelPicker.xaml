<Window x:Class="DzhiggaTV.App.SportsChannelPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DzhiggaTV · Выбор каналов" Width="650" Height="700" MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Row" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource MutedBrush}" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
      <Path x:Name="Tick" Data="M 0,4 L 3,7 9,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="10" Height="9" Stretch="Uniform" Visibility="Collapsed"/>
     </Border><ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Каналы для спортивного вечера" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Выберите до 9 каналов. Звук будет идти с одного выбранного канала." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,10,0"><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="Поиск по названию канала" AutomationProperties.Name="Поиск каналов для спортивного вечера"/>
    <TextBlock Text="Поиск каналов" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <ComboBox x:Name="Category" Grid.Column="1" SelectionChanged="Category_Changed" ToolTip="Категория" AutomationProperties.Name="Категория каналов для спортивного вечера"/>
  </Grid>
  <Grid Grid.Row="2"><ListBox x:Name="Channels" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Padding="8,9" Margin="0,1" AutomationProperties.Name="{Binding Channel.Name}">
    <Grid Margin="8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Channel.Number}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
     <Image Grid.Column="1" Source="{Binding Channel.LogoPath}" Width="30" Height="30" Stretch="Uniform"/>
     <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="{Binding Channel.Name}" TextTrimming="CharacterEllipsis" FontSize="14"/><TextBlock Text="{Binding Channel.Group}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
    </Grid>
   </CheckBox></DataTemplate></ListBox.ItemTemplate>
  </ListBox><TextBlock x:Name="Empty" Text="Каналы не найдены" Visibility="Collapsed" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Count" FontSize="12"/><TextBlock x:Name="Limit" FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="Сначала снимите выбор с одного из каналов" Visibility="Collapsed"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Отмена" IsCancel="True"/><Button x:Name="Watch" Content="Смотреть" IsDefault="True" Click="Watch_Click" BorderBrush="{DynamicResource AccentBrush}"/></StackPanel>
  </Grid>
 </Grid>
</Window>
