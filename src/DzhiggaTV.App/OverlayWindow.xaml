<Window x:Class="DzhiggaTV.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" PreviewKeyDown="Overlay_KeyDown" MouseEnter="Overlay_MouseEnter" MouseLeave="Overlay_MouseLeave" MouseMove="Overlay_MouseMove" PreviewMouseDown="Overlay_PreviewMouseDown" MouseLeftButtonDown="Overlay_MouseDown" LostKeyboardFocus="Overlay_LostKeyboardFocus">
 <Window.Resources>
  <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Background" Value="#CC1D272E"/><Setter Property="Foreground" Value="#EEF3F5"/><Setter Property="BorderBrush" Value="#3B4852"/>
  </Style>
 </Window.Resources>
 <Grid Background="#01000000" x:Name="OverlayRoot">
  <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430" Margin="30"><TextBlock Text="▶" Foreground="{DynamicResource AccentBrush}" FontSize="52" HorizontalAlignment="Center"/><TextBlock Text="Ваш эфир. Ваш ритм." FontSize="27" FontWeight="Light" HorizontalAlignment="Center" Margin="0,22,0,12"/><TextBlock Text="Импортируйте плейлист и выберите канал.&#10;Телепрограмма и логотипы — из EPG.ONE." TextAlignment="Center" Foreground="#91A0AC" LineHeight="23"/><Button Content="Открыть плейлист" Click="Import_Click" Background="#19413F" Margin="0,24,0,0" HorizontalAlignment="Center"/></StackPanel>
  <Border x:Name="StatisticsPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,12,48" Background="#DD10181F" CornerRadius="8" Padding="15" Visibility="Collapsed" MaxWidth="550"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StatisticsText" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#DDE8ED" TextWrapping="Wrap"/></ScrollViewer></Border>
  <Border x:Name="Drawer" Width="340" HorizontalAlignment="Left" Background="#F0161E25" Margin="8,12,0,48" CornerRadius="9" Visibility="Collapsed" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="КАНАЛЫ" Foreground="#63D9CD" FontSize="11" Margin="8,8,0,8"/><ListBox ItemsSource="{Binding VisibleChannels}" DisplayMemberPath="Name" SelectionChanged="Drawer_Selected"/></DockPanel></Border>
  <Border x:Name="ControlsPanel" VerticalAlignment="Bottom" Background="#D911191F" CornerRadius="7" Margin="3" Padding="6,4" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button x:Name="HistoryButton" Style="{StaticResource PlayerButton}" Content="↶" Click="Previous_Click" ToolTip="Предыдущий просмотренный (Backspace)"/><Button Style="{StaticResource PlayerButton}" Content="◀" Click="ChannelBack_Click" ToolTip="Канал назад (PgUp)"/><Button x:Name="PauseButton" Style="{StaticResource PlayerButton}" Content="Ⅱ" Click="Pause_Click" ToolTip="Пауза (Space)"/><Button Style="{StaticResource PlayerButton}" Content="▶" Click="ChannelNext_Click" ToolTip="Следующий канал (PgDn)"/><Button x:Name="MuteButton" Style="{StaticResource PlayerButton}" Content="♪" Click="Mute_Click" ToolTip="Звук (M)"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="70" Value="70" ValueChanged="Volume_Changed" VerticalAlignment="Center" Margin="5,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="FavoriteButton" Style="{StaticResource PlayerButton}" Content="☆" Click="Favorite_Click" ToolTip="Избранное (F)"/><Button Style="{StaticResource PlayerButton}" Content="▤" Click="Channels_Click" ToolTip="Каналы (C)"/><Button Style="{StaticResource PlayerButton}" Content="•••" Click="More_Click" ToolTip="Аудио, субтитры, изображение и статистика"/><Button x:Name="MiniButton" Style="{StaticResource PlayerButton}" Content="▣" Click="Mini_Click" ToolTip="Мини-плеер (Ctrl+M)"/><Button Style="{StaticResource PlayerButton}" Content="⛶" Click="Fullscreen_Click" ToolTip="Полный экран (F11) / Вернуться"/></StackPanel>
   </Grid></Border>
 </Grid>
</Window>
