<Window x:Class="DzhiggaTV.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" PreviewKeyDown="Overlay_KeyDown" MouseEnter="Overlay_MouseEnter" MouseLeave="Overlay_MouseLeave" MouseMove="Overlay_MouseMove" PreviewMouseDown="Overlay_PreviewMouseDown" MouseLeftButtonDown="Overlay_MouseDown" LostKeyboardFocus="Overlay_LostKeyboardFocus">
 <Window.Resources>
  <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Background" Value="#CC1D272E"/><Setter Property="Foreground" Value="#EEF3F5"/><Setter Property="BorderBrush" Value="#3B4852"/>
  </Style>
 </Window.Resources>
 <Grid Background="#01000000" x:Name="OverlayRoot">
  <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430" Margin="30"><TextBlock Text="▶" Foreground="{DynamicResource AccentBrush}" FontSize="52" HorizontalAlignment="Center"/><TextBlock Text="Ваш эфир. Ваш ритм." FontSize="27" FontWeight="Light" HorizontalAlignment="Center" Margin="0,22,0,12"/><TextBlock Text="Импортируйте плейлист и выберите канал.&#10;Телепрограмма и логотипы — из EPG.ONE." TextAlignment="Center" Foreground="#91A0AC" LineHeight="23"/><Button Content="Открыть плейлист" Click="Import_Click" Background="#19413F" Margin="0,24,0,0" HorizontalAlignment="Center"/></StackPanel>
  <Border x:Name="StatisticsPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,12,48" Background="#DD10181F" CornerRadius="8" Padding="15" Visibility="Collapsed" MaxWidth="550"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StatisticsText" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#DDE8ED" TextWrapping="Wrap"/></ScrollViewer></Border>
  <Border x:Name="Drawer" Width="340" HorizontalAlignment="Left" Background="#F0161E25" Margin="8,12,0,48" CornerRadius="9" Visibility="Collapsed" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="КАНАЛЫ" Foreground="#63D9CD" FontSize="11" Margin="8,8,0,8"/><ListBox ItemsSource="{Binding VisibleChannels}" ItemTemplate="{StaticResource ChannelNameTemplate}" SelectionChanged="Drawer_Selected"/></DockPanel></Border>
  <Border x:Name="ControlsPanel" VerticalAlignment="Bottom" Background="#D911191F" CornerRadius="7" Margin="3" Padding="6,4" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="FullscreenProgrammeInfo" Grid.ColumnSpan="3" Margin="16,12,16,12" Visibility="Collapsed" AutomationProperties.Name="Сейчас в эфире">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ActiveName}" FontSize="12" Foreground="#63D9CD" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      <TextBlock Grid.Column="1" Text="{Binding CurrentTime}" FontSize="12" Foreground="#A9BAC4"/>
     </Grid>
     <TextBlock Text="{Binding CurrentTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#EEF3F5" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
     <Grid x:Name="FullscreenProgrammeReadingArea" Margin="0,3,0,12">
      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding CurrentDescription}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="FullscreenMetadataGap" Width="24"/><ColumnDefinition x:Name="FullscreenMetadataColumn" Width="300"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="FullscreenSynopsisScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="216" PreviewMouseWheel="Description_MouseWheel" AutomationProperties.Name="Описание фильма">
       <StackPanel>
        <TextBlock Text="ОПИСАНИЕ" FontSize="10" Foreground="#8EA5B4" Margin="0,0,0,7"/>
        <TextBlock x:Name="FullscreenProgrammeDescription" Text="{Binding CurrentProgrammeText.Synopsis}" FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" Foreground="#E0E8ED" TextWrapping="Wrap" Margin="0,0,10,0"/>
       </StackPanel>
       <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding CurrentProgrammeText.Synopsis}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      </ScrollViewer>
      <ScrollViewer x:Name="FullscreenMetadataScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="216" PreviewMouseWheel="Description_MouseWheel" AutomationProperties.Name="Сведения о фильме">
       <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CurrentProgrammeText.Metadata}" Value=""/><Condition Binding="{Binding CurrentProgrammeText.Credits}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></ScrollViewer.Style>
       <Border BorderBrush="#35414A" BorderThickness="1,0,0,0" Padding="18,0,8,0"><StackPanel>
        <TextBlock Text="О ФИЛЬМЕ" FontSize="10" Foreground="#63D9CD" Margin="0,0,0,7"/>
        <TextBlock Text="{Binding CurrentProgrammeText.Metadata}" FontSize="12" LineHeight="19" Foreground="#B9C9D4" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding CurrentProgrammeText.Credits}" FontSize="12" LineHeight="19" Foreground="#A9BAC4" TextWrapping="Wrap" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel></Border>
      </ScrollViewer>
     </Grid>
     <ProgressBar Value="{Binding CurrentProgress, Mode=OneWay}" Height="3" Background="#35414A" Foreground="#63D9CD"/>
    </StackPanel>
    <StackPanel x:Name="PlaybackButtons" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"><Button Style="{StaticResource PlayerButton}" Content="◀" Click="ChannelBack_Click" ToolTip="Канал назад (PgUp)"/><Button x:Name="PauseButton" Style="{StaticResource PlayerButton}" Content="Ⅱ" Click="Pause_Click" ToolTip="Пауза (Space)"/><Button Style="{StaticResource PlayerButton}" Content="▶" Click="ChannelNext_Click" ToolTip="Следующий канал (PgDn)"/><Button x:Name="MuteButton" Style="{StaticResource PlayerButton}" Content="♪" Click="Mute_Click" ToolTip="Звук (M)"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Width="70" Value="70" ValueChanged="Volume_Changed" VerticalAlignment="Center" Margin="5,0"/></StackPanel>
    <TextBlock x:Name="RemainingTimeText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#8998A4" Margin="12,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"><Run Text="До конца осталось: "/><Run x:Name="RemainingTimeValue" Text=""/></TextBlock>
    <StackPanel x:Name="PlayerActions" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="FavoriteButton" Style="{StaticResource PlayerButton}" Content="{Binding Active.FavoriteGlyph}" Click="Favorite_Click" ToolTip="Избранное (F)"/><Button Style="{StaticResource PlayerButton}" Content="•••" Click="More_Click" ToolTip="Аудио, субтитры, изображение и статистика"/><Button x:Name="MiniButton" Style="{StaticResource PlayerButton}" Content="▣" Click="Mini_Click" ToolTip="Мини-плеер (Ctrl+M)"/><Button Style="{StaticResource PlayerButton}" Content="⛶" Click="Fullscreen_Click" ToolTip="Полный экран (F11) / Вернуться"/></StackPanel>
   </Grid></Border>
 </Grid>
</Window>
