<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <MainViewModelSource Condition="'$(MainViewModelSource)' == ''">../../src/DzhiggaTV.App/MainViewModel.cs</MainViewModelSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DzhiggaTV.Core/DzhiggaTV.Core.csproj" />
    <ProjectReference Include="../../src/DzhiggaTV.Services/DzhiggaTV.Services.csproj" />
    <Compile Include="$(MainViewModelSource)" Link="MainViewModel.cs" />
    <Compile Include="../../src/DzhiggaTV.App/Infrastructure.cs" Link="Infrastructure.cs" />
    <Compile Include="../../src/DzhiggaTV.App/SportsSession.cs" Link="SportsSession.cs" />
    <Compile Include="../../src/DzhiggaTV.App/SportsLayout.cs" Link="SportsLayout.cs" />
    <Compile Include="../../src/DzhiggaTV.App/MultiscreenGeometry.cs" Link="MultiscreenGeometry.cs" />
    <Compile Include="../../src/DzhiggaTV.App/ProgrammeTiming.cs" Link="ProgrammeTiming.cs" />
    <Compile Include="../../src/DzhiggaTV.App/GuideTimeline.cs" Link="GuideTimeline.cs" />
    <Compile Include="../../src/DzhiggaTV.App/WindowBoundsGeometry.cs" Link="WindowBoundsGeometry.cs" />
    <Compile Include="../../src/DzhiggaTV.App/PointerRevealGate.cs" Link="PointerRevealGate.cs" />
  </ItemGroup>
</Project>
